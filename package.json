{
  "name": "pi-do",
  "version": "0.1.0",
  "description": "Standalone task panel and task tools for Pi, with optional Dex integration.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "keywords": [
    "pi-package",
    "pi",
    "dex",
    "tasks"
  ],
  "files": [
    "src/",
    "schema.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc && bun test",
    "pack:check": "bun pm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
